{
  "name": "deepseek-harness-desktop",
  "productName": "DeepSeek Harness",
  "version": "0.1.3",
  "description": "DeepSeek Harness Windows desktop client (Electron shell + bundled Node runtime + bundled dsh)",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prepare:resources": "node scripts/prepare-resources.js",
    "pack": "npm run prepare:resources && electron-builder --dir",
    "dist": "npm run prepare:resources && electron-builder --win nsis",
    "dist:store": "npm run prepare:resources && electron-builder --win msix --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.deepseek.harness.desktop",
    "productName": "DeepSeek Harness",
    "directories": {
      "output": "release"
    },
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/node",
        "to": "node"
      },
      {
        "from": "resources/dsh.zip",
        "to": "dsh.zip"
      },
      {
        "from": "resources/build-info.json",
        "to": "build-info.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness"
    },
    "msix": {
      "identityName": "wika.DS",
      "publisher": "CN=9414047A-A9B8-44C8-8556-193718E99432",
      "publisherDisplayName": "wika",
      "displayName": "DS桌面版",
      "applicationId": "wika.DS",
      "createMsixupload": true,
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.22621.0",
      "languages": [
        "zh-CN",
        "en-US"
      ],
      "backgroundColor": "#0b0e14",
      "capabilities": [
        "runFullTrust",
        "internetClient",
        "internetClientServer"
      ],
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
